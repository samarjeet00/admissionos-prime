# AdmissionOS Prime configuration. Copy to .env and fill in. Keep comments on their own lines.

# ---------- Claude ----------
# API key from https://console.anthropic.com (API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=32000
# 1 = server-side refusal fallbacks (Claude API only; use 0 on Bedrock/Vertex)
ANTHROPIC_FALLBACKS=1

# ---------- Admissions portal MCP server (PUAP) ----------
# Streamable-HTTP endpoint of the PUAP MCP server, e.g. https://mcp.example.com/mcp
PUAP_MCP_URL=
# Bearer token for that endpoint, if it needs one
PUAP_MCP_TOKEN=
# Or launch it locally over stdio instead of using the URL, e.g. python /opt/puap-mcp/server.py
PUAP_MCP_COMMAND=
TOOL_RESULT_MAX_CHARS=80000
TOOL_CALL_TIMEOUT=300
MAX_TOOL_ROUNDS=25
# Comma-separated tool names to hide from everyone
EXTRA_DENIED_TOOLS=

# ---------- Telegram (from @BotFather; long polling, no public URL needed) ----------
TELEGRAM_BOT_TOKEN=

# ---------- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp) ----------
# Permanent System User token with whatsapp_business_messaging
WHATSAPP_TOKEN=
# WhatsApp > API Setup > Phone number ID
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string; paste the same one into the Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WEBHOOK_HOST=0.0.0.0
# Expose https://<your-domain>/webhook to Meta via reverse proxy or tunnel.bat
WEBHOOK_PORT=8765

# ---------- Google Sheets reference (historical exam & result dates; READ-ONLY) ----------
# Service-account JSON key; share the sheet with the account's email as Viewer
GOOGLE_SERVICE_ACCOUNT_FILE=data/google-service-account.json
REFERENCE_SHEET_ID=1mgmv4Cc67olcCN-U7vkNC0q-MVD-23F0_UCAdRODyvk
REFERENCE_SHEET_TABS=Board Exam & Result Dates,Entrance Exam & Result Dates,Last Dates Performance
REFERENCE_REFRESH_HOURS=6

# ---------- Which model service powers the brain ----------
# anthropic = Claude via console.anthropic.com credits (best quality)
# vertex    = Claude via Google Cloud Vertex AI (billed to the GCP project; uses the service-account key)
# gemini    = Google Gemini Developer API free tier (no billing; uses the service-account key, or GEMINI_API_KEY)
LLM_PROVIDER=anthropic
VERTEX_PROJECT_ID=
VERTEX_REGION=global
# Optional: an AI Studio API key instead of the service account
GEMINI_API_KEY=
# The Google project that has the Gemini API enabled (defaults to VERTEX_PROJECT_ID)
GEMINI_PROJECT_ID=
# auto = newest flash model available, or e.g. gemini-2.5-pro
GEMINI_MODEL=auto
# When Gemini quota is exhausted, retry on: anthropic | vertex | none
LLM_FALLBACK_PROVIDER=anthropic

# ---------- Backup brains (free) ----------
# Mistral "Experiment" plan: console.mistral.ai -> API Keys (free, no card). Used as fallback when Gemini's quota is hit,
# or as the primary brain with LLM_PROVIDER=mistral.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
# Any other OpenAI-compatible endpoint (Groq, Cerebras, OpenRouter, local): LLM_PROVIDER=openai_compat
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Fallback order when the primary is rate-limited or overloaded
LLM_FALLBACK_PROVIDERS=mistral,anthropic
# Gemini self-imposed request budget per minute (free tier shared cap is ~20) and max model hops per request
GEMINI_RPM_BUDGET=14
GEMINI_MAX_HOPS=2
