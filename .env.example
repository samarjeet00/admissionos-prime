# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high                   # low | medium | high | xhigh | max
ANTHROPIC_MAX_TOKENS=32000
ANTHROPIC_FALLBACKS=1                   # server-side refusal fallbacks (Claude API only; 0 on Bedrock/Vertex)

# --- Admissions portal MCP server (PUAP) ---
PUAP_MCP_URL=https://<host>/mcp         # streamable-HTTP endpoint of the PUAP MCP server
PUAP_MCP_TOKEN=                         # bearer token if the endpoint requires one
# PUAP_MCP_COMMAND=python /opt/puap-mcp/server.py   # or run it locally over stdio instead
TOOL_RESULT_MAX_CHARS=80000
TOOL_CALL_TIMEOUT=300
MAX_TOOL_ROUNDS=25
EXTRA_DENIED_TOOLS=                     # comma-separated tool names to hide from everyone

# --- Telegram (from @BotFather; long polling, no public URL needed) ---
TELEGRAM_BOT_TOKEN=

# --- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp) ---
WHATSAPP_TOKEN=                         # permanent System User token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=               # WhatsApp > API Setup > Phone number ID
WHATSAPP_VERIFY_TOKEN=                  # any secret string; paste the same into the webhook config
WHATSAPP_APP_SECRET=                    # App settings > Basic > App secret (verifies webhook signatures)
WHATSAPP_API_VERSION=v21.0
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8765                       # expose https://<your-domain>/webhook to Meta via reverse proxy or tunnel
