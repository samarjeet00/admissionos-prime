# AdmissionOS Prime configuration. Copy to .env and fill in. Keep comments on their own lines.

# ---------- Claude ----------
# API key from https://console.anthropic.com (API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=32000
# 1 = server-side refusal fallbacks (Claude API only; use 0 on Bedrock/Vertex)
ANTHROPIC_FALLBACKS=1

# ---------- Admissions portal MCP server (PUAP) ----------
# Streamable-HTTP endpoint of the PUAP MCP server, e.g. https://mcp.example.com/mcp
PUAP_MCP_URL=
# Bearer token for that endpoint, if it needs one
PUAP_MCP_TOKEN=
# Or launch it locally over stdio instead of using the URL, e.g. python /opt/puap-mcp/server.py
PUAP_MCP_COMMAND=
TOOL_RESULT_MAX_CHARS=80000
TOOL_CALL_TIMEOUT=300
MAX_TOOL_ROUNDS=25
# Comma-separated tool names to hide from everyone
EXTRA_DENIED_TOOLS=

# ---------- Telegram (from @BotFather; long polling, no public URL needed) ----------
TELEGRAM_BOT_TOKEN=

# ---------- WhatsApp Cloud API (Meta for Developers > your app > WhatsApp) ----------
# Permanent System User token with whatsapp_business_messaging
WHATSAPP_TOKEN=
# WhatsApp > API Setup > Phone number ID
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string; paste the same one into the Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WEBHOOK_HOST=0.0.0.0
# Expose https://<your-domain>/webhook to Meta via reverse proxy or tunnel.bat
WEBHOOK_PORT=8765

# ---------- Google Sheets reference (historical exam & result dates; READ-ONLY) ----------
# Service-account JSON key; share the sheet with the account's email as Viewer
GOOGLE_SERVICE_ACCOUNT_FILE=data/google-service-account.json
REFERENCE_SHEET_ID=1mgmv4Cc67olcCN-U7vkNC0q-MVD-23F0_UCAdRODyvk
REFERENCE_SHEET_TABS=Board Exam & Result Dates,Entrance Exam & Result Dates
REFERENCE_REFRESH_HOURS=6
